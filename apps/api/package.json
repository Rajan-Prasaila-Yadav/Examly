{
  "name": "@examly/api",
  "version": "1.0.0",
  "description": "Examly Multi-Tenant Fastify High-Performance REST API",
  "author": "Examly",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "ts-node src/main.ts",
    "build": "tsc -p tsconfig.json",
    "vercel-build": "npx prisma generate --schema=../../database/prisma/schema && tsc -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" --fix"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/client": "^5.17.0",
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "bullmq": "^6.3.4",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.1",
    "fastify-plugin": "^5.0.1",
    "google-auth-library": "^9.15.1",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^3.3.8",
    "pdfmake": "^0.2.18",
    "resend": "^4.1.2",
    "uuid": "^11.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.5",
    "@types/pdfmake": "^0.2.11",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.17.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
