{
  "name": "@examly/database",
  "version": "1.0.0",
  "description": "Prisma PostgreSQL ORM and schema package for Examly",
  "main": "index.js",
  "scripts": {
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:deploy": "npx prisma migrate deploy",
    "db:generate": "npx prisma generate",
    "db:seed": "npx ts-node prisma/seed.ts",
    "db:studio": "npx prisma studio"
  },
  "prisma": {
    "seed": "npx ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.17.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.13.5",
    "bcrypt": "^5.1.1",
    "prisma": "^5.17.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
