// database/prisma/schema/base.prisma
// Base configuration: PostgreSQL Datasource & Prisma Client Generator

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
