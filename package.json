{
  "name": "examly-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Examly Multi-Tenant Learning & Examination Platform Monorepo",
  "workspaces": [
    "apps/*",
    "database"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@examly/api",
    "dev:web": "npm run dev --workspace=@examly/web",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "build:web": "npm run build --workspace=@examly/web",
    "build": "npm run build:api && npm run build:web",
    "start:api": "npm run start --workspace=@examly/api",
    "start:web": "npm run start --workspace=@examly/web",
    "start": "npm run start:api",
    "vercel-build": "npx prisma generate --schema=database/prisma/schema && npm run build:api",
    "db:push": "npm run db:push --workspace=@examly/database",
    "db:migrate": "npm run db:migrate --workspace=@examly/database",
    "db:generate": "npx prisma generate --schema=database/prisma/schema",
    "db:seed": "npm run db:seed --workspace=@examly/database",
    "db:studio": "npm run db:studio --workspace=@examly/database",
    "benchmark": "node scripts/benchmark-baseline.js",
    "benchmark:fastify": "node scripts/benchmark-fastify.js",
    "benchmark:db": "node scripts/benchmark-database.js",
    "benchmark:p5": "node scripts/benchmark-api-p5.js",
    "security:test": "node scripts/verify-security-expanded.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@prisma/client": "^5.17.0",
    "@types/node": "^26.4.0",
    "prisma": "^5.17.0",
    "socket.io-client": "^4.8.3"
  }
}
